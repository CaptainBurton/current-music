# Copy to .env next to compose.yaml (or set these as Portainer stack environment variables).

# Required: the folder on this server that holds your music.
MUSIC_PATH=/mnt/music

# Optional: the port Current listens on (default 8787).
#CURRENT_PORT=8787

# Optional: keep data in a host folder instead of the current_data Docker volume.
#DATA_PATH=/srv/current/data

# Optional: set to 1 when Current is behind an HTTPS reverse proxy.
#CURRENT_SECURE_COOKIES=1

# Optional: an email or https:// website that identifies MusicBrainz lookups.
#MUSICBRAINZ_CONTACT=you@example.com
